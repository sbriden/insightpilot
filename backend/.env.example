# Local docker-compose maps host 5433 → container 5432.
DATABASE_URL=postgresql://insightpilot:insightpilot@localhost:5433/insightpilot

# Comma-separated browser origins allowed to call the API.
# Include the Render web URL in production, e.g.:
# CORS_ORIGINS=https://insightpilot-web.onrender.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Shared password for the admin studio. Leave empty to disable auth (local).
ADMIN_PASSWORD=
# Optional signing secret for admin tokens (defaults to ADMIN_PASSWORD).
ADMIN_SESSION_SECRET=

# Optional AI enrichment. Analytical paths work without these.
# Set INSIGHTPILOT_AI_ENABLED=0 to force deterministic overlays.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
INSIGHTPILOT_AI_ENABLED=1

# Unused placeholders (not wired in app code yet).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
